{
  "printWidth": 100,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/wasm/**",
    "**/generated.ts",
    "**/tests/vectors/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "web/**",
    "schema/**",
    "target/**",
    "bun.lock",
    "**/*.md"
  ]
}
