#!/usr/bin/env python3
"""A fake model service that speaks just enough of the OpenAI Responses API (SSE) for a real `codex app-server`.

  fake-responses <plan.json> [requests.jsonl]
                                 listens on 127.0.0.1 on a free port and prints `PORT=<n>` as its first line;
                                 with a second argument, appends every request body (one JSON document per line) there

`plan.json` is a list with one entry per `POST /v1/responses` (the first request gets the first entry, ...). An entry is a
list of steps: {"text": "..."} | {"reasoning": "..."} | {"function_call": {"name": ..., "arguments": {...}}} |
{"sleep": seconds} | {"http_status": 401, "body": {...}} (as the only step: answer with an HTTP error).
Used only by tests/real_codex.rs, with a temporary CODEX_HOME whose config.toml points a custom model provider here, so
nothing goes to the network and the user's own provider is never touched.
"""
import json
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

plan = json.load(open(sys.argv[1]))
request_log = sys.argv[2] if len(sys.argv) > 2 else None
state = {"n": 0}
lock = threading.Lock()


def sse(w, ev, data):
    w.write(("event: %s\ndata: %s\n\n" % (ev, json.dumps(data))).encode())
    w.flush()


class H(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass

    def do_POST(self):
        n = int(self.headers.get("content-length", "0"))
        body = self.rfile.read(n)
        with lock:
            i = state["n"]
            state["n"] += 1
            if request_log:
                try:
                    line = json.dumps(json.loads(body))
                except ValueError:
                    line = json.dumps({"raw": body.decode("utf-8", "replace")})
                with open(request_log, "a") as f:
                    f.write(line + "\n")
        steps = plan[i] if i < len(plan) else [{"text": "(no more plan)"}]
        if steps and "http_status" in steps[0]:
            body = json.dumps(steps[0].get("body", {"error": {"message": "fake error"}})).encode()
            self.send_response(steps[0]["http_status"])
            self.send_header("content-type", "application/json")
            self.send_header("content-length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        self.send_response(200)
        self.send_header("content-type", "text/event-stream")
        self.send_header("cache-control", "no-cache")
        self.send_header("connection", "close")
        self.end_headers()
        w = self.wfile
        try:
            sse(w, "response.created", {"type": "response.created", "response": {"id": "resp_%d" % i, "status": "in_progress"}})
            for oi, step in enumerate(steps):
                if "sleep" in step:
                    time.sleep(step["sleep"])
                elif "text" in step:
                    mid = "msg_%d_%d" % (i, oi)
                    sse(w, "response.output_item.added", {"type": "response.output_item.added", "output_index": oi, "item": {"type": "message", "id": mid, "role": "assistant", "content": []}})
                    sse(w, "response.content_part.added", {"type": "response.content_part.added", "item_id": mid, "output_index": oi, "content_index": 0, "part": {"type": "output_text", "text": ""}})
                    for word in step["text"].split(" "):
                        sse(w, "response.output_text.delta", {"type": "response.output_text.delta", "item_id": mid, "output_index": oi, "content_index": 0, "delta": word + " "})
                    sse(w, "response.output_item.done", {"type": "response.output_item.done", "output_index": oi, "item": {"type": "message", "id": mid, "role": "assistant", "content": [{"type": "output_text", "text": step["text"]}]}})
                elif "reasoning" in step:
                    rid = "rs_%d_%d" % (i, oi)
                    sse(w, "response.output_item.added", {"type": "response.output_item.added", "output_index": oi, "item": {"type": "reasoning", "id": rid, "summary": []}})
                    sse(w, "response.reasoning_summary_part.added", {"type": "response.reasoning_summary_part.added", "item_id": rid, "output_index": oi, "summary_index": 0, "part": {"type": "summary_text", "text": ""}})
                    sse(w, "response.reasoning_summary_text.delta", {"type": "response.reasoning_summary_text.delta", "item_id": rid, "output_index": oi, "summary_index": 0, "delta": step["reasoning"]})
                    sse(w, "response.output_item.done", {"type": "response.output_item.done", "output_index": oi, "item": {"type": "reasoning", "id": rid, "summary": [{"type": "summary_text", "text": step["reasoning"]}]}})
                elif "function_call" in step:
                    fc = step["function_call"]
                    item = {"type": "function_call", "id": "fc_%d_%d" % (i, oi), "call_id": "call_%d_%d" % (i, oi), "name": fc["name"], "arguments": json.dumps(fc["arguments"]), "status": "completed"}
                    sse(w, "response.output_item.added", {"type": "response.output_item.added", "output_index": oi, "item": dict(item, arguments="")})
                    sse(w, "response.output_item.done", {"type": "response.output_item.done", "output_index": oi, "item": item})
            sse(w, "response.completed", {"type": "response.completed", "response": {"id": "resp_%d" % i, "status": "completed", "usage": {"input_tokens": 100, "input_tokens_details": {"cached_tokens": 10}, "output_tokens": 20, "output_tokens_details": {"reasoning_tokens": 0}, "total_tokens": 120}}})
        except (BrokenPipeError, ConnectionResetError):
            pass


server = ThreadingHTTPServer(("127.0.0.1", 0), H)
print("PORT=%d" % server.server_address[1], flush=True)
server.serve_forever()
