{
  "name": "@anycon/protocol",
  "version": "0.1.0",
  "description": "TypeScript side of the Anycon protocol: generated types, envelope msgpack codec, JSON-RPC, and the Noise wasm wrapper.",
  "homepage": "https://github.com/anycon-ai/anycon/tree/main/packages/protocol#readme",
  "bugs": {
    "url": "https://github.com/anycon-ai/anycon/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anycon-ai/anycon.git",
    "directory": "packages/protocol"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "src",
    "wasm/anycon_crypto.js",
    "wasm/anycon_crypto.d.ts",
    "wasm/anycon_crypto_bg.wasm",
    "wasm/anycon_crypto_bg.wasm.d.ts",
    "wasm/THIRD-PARTY-LICENSES.txt",
    "README.md",
    "README.zh-CN.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wasm/*": "./wasm/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "test:node": "node --import tsx --conditions source --test \"tests/**/*.test.ts\"",
    "lint": "oxlint -c ../../.oxlintrc.json src tests tools",
    "fmt": "oxfmt --config ../../.oxfmtrc.json src tests tools",
    "prepack": "bash tools/prepack.sh"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
